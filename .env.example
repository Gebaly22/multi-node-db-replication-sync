# Replace every placeholder before starting the deployment.
# Passwords are required; Compose supplies documented non-secret defaults.
CONTAINER_DB_USER=<CONTAINER_DB_USER>
CONTAINER_DB_PASSWORD=<CONTAINER_DB_PASSWORD>
CONTAINER_DB_NAME=<CONTAINER_DB_NAME>
VM_DB_HOST=<VM_DB_HOST>
VM_DB_USER=<VM_DB_USER>
VM_DB_PASSWORD=<VM_DB_PASSWORD>
VM_DB_NAME=<VM_DB_NAME>
SQL_DB_HOST=<SQL_DB_HOST>
SQL_DB_USER=<SQL_DB_USER>
SQL_DB_PASSWORD=<SQL_DB_PASSWORD>
SQL_DB_NAME=<SQL_DB_NAME>
